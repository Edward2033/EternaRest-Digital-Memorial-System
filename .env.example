
# ==========================
# FRONTEND ENVIRONMENT
# ==========================
# Copy this file to .env and fill in your values.
# All variables MUST start with VITE_ to be exposed to the browser.
# NEVER put backend secrets here.


# ==========================
# BACKEND CONNECTION
# ==========================

# Development:  http://localhost:5000/api
# Production:   https://your-backend.onrender.com/api
VITE_API_BASE_URL=https://your-backend.onrender.com/api


# ==========================
# APP IDENTITY
# ==========================

VITE_APP_NAME=EternaRest Memorial Services


# ==========================
# CLOUDINARY (Direct Browser Uploads)
# ==========================

# The preset MUST be set to "unsigned" in Cloudinary dashboard
# Settings → Upload → Upload presets → Add unsigned preset
# Name it: eternarest_unsigned

VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=eternarest_unsigned
