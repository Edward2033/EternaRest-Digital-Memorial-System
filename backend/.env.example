
# ==========================
# SERVER CONFIGURATION
# ==========================

PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-frontend.vercel.app
ALLOWED_ORIGINS=https://your-frontend.vercel.app


# ==========================
# DATABASE
# ==========================

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/eternarest


# ==========================
# AUTHENTICATION & SECURITY
# ==========================

# Must be a long random string — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_very_long_random_secret_minimum_32_chars


# ==========================
# FILE STORAGE / CLOUDINARY
# ==========================

# Used for:
#   - QR code images (eternarest/qrcodes)
#   - CMS image uploads (eternarest/cms)
#   - Memorial media (uploaded directly from browser via unsigned preset)
#
# Sign up free at: https://cloudinary.com/users/register_free
# Dashboard → copy Cloud Name, API Key, API Secret
# Settings → Upload → create an unsigned preset named: eternarest_unsigned

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


# ==========================
# EMAIL SERVICE (Brevo SMTP)
# ==========================

# Free tier: 300 emails/day
# Sign up at: https://app.brevo.com/account/register
# Settings → SMTP & API → Generate SMTP key
# Senders → Add and verify your sender email

EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=your_brevo_account_email@example.com
EMAIL_PASS=your_brevo_smtp_key_here
EMAIL_FROM=EternaRest Memorial <noreply@eternarest.com>


# ==========================
# PAYMENT — MTN MOBILE MONEY
# ==========================

# Merchant display numbers (shown to customer during payment)
MTN_MOMO_NUMBER=+250794890144
AIRTEL_MONEY_NUMBER=+250794890144
WHATSAPP_NUMBER=+250794890144

# Currency & conversion
MOMO_CURRENCY=RWF
USD_TO_RWF_RATE=1300

# Set to false in production to use real MTN/Airtel APIs
MOMO_SANDBOX=false

# MTN MoMo Open API — https://momodeveloper.mtn.com/
# Sandbox:    https://sandbox.momodeveloper.mtn.com
# Production: https://proxy.momoapi.mtn.com
MTN_BASE_URL=https://proxy.momoapi.mtn.com
MTN_COLLECTION_PRIMARY_KEY=your_primary_subscription_key
MTN_API_USER=your_api_user_uuid
MTN_API_KEY=your_api_key
MTN_CALLBACK_URL=https://your-backend.onrender.com/api/payments/momo/webhook

# Airtel Money Africa API — https://developers.airtel.africa/
AIRTEL_BASE_URL=https://openapi.airtel.africa
AIRTEL_CLIENT_ID=your_client_id
AIRTEL_CLIENT_SECRET=your_client_secret
AIRTEL_COUNTRY=RW


# ==========================
# QR CODE SYSTEM
# ==========================

# The public frontend URL embedded inside every QR code
# Must match FRONTEND_URL — QR codes encode: <FRONTEND_URL>/memorial/<memorialId>
# Changing this after QR codes are printed will break existing codes
FRONTEND_URL=https://your-frontend.vercel.app


# ==========================
# LOGGING
# ==========================

LOG_LEVEL=info
