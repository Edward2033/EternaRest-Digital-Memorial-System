# Backend Environment Variables Template
# Copy this file to .env and fill in your values

# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/eternarest

# ─── Server Configuration ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
JWT_SECRET=change_this_to_a_very_long_random_secret_in_production

# CORS Origins (comma-separated, optional in development)
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# ─── Email Configuration (Brevo SMTP Recommended) ─────────────────────────────
# Sign up at: https://app.brevo.com/account/register
# Free tier: 300 emails/day
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=your_brevo_account_email@example.com
EMAIL_PASS=your_brevo_smtp_key_here
EMAIL_FROM=EternaRest Memorial <noreply@eternarest.com>

# Fallback: Gmail SMTP (less reliable for transactional emails)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_USER=your_gmail@gmail.com
# EMAIL_PASS=your_app_password

# ─── Payment Configuration ────────────────────────────────────────────────────

# Merchant Contact Numbers
MTN_MOMO_NUMBER=+250794890144
AIRTEL_MONEY_NUMBER=+250794890144
WHATSAPP_NUMBER=+250794890144

# Currency & Conversion
MOMO_CURRENCY=RWF
USD_TO_RWF_RATE=1300

# Sandbox Mode (set to true for testing, false for production)
MOMO_SANDBOX=true

# MTN Mobile Money API (Production)
# Sign up at: https://momodeveloper.mtn.com/
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_COLLECTION_PRIMARY_KEY=your_primary_key_here
MTN_API_USER=your_api_user_uuid_here
MTN_API_KEY=your_api_key_here
MTN_CALLBACK_URL=https://yourdomain.com/api/payments/momo/webhook

# Airtel Money API (Production)
# Sign up at: https://developers.airtel.africa/
AIRTEL_BASE_URL=https://openapi.airtel.africa
AIRTEL_CLIENT_ID=your_client_id_here
AIRTEL_CLIENT_SECRET=your_client_secret_here
AIRTEL_COUNTRY=RW

# ─── Cloudinary Configuration (Optional - Backend Uploads) ────────────────────
# If not configured, uploads will be stored locally in /uploads/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Notes ────────────────────────────────────────────────────────────────────
# 1. NEVER commit this file to version control
# 2. Change JWT_SECRET to a long random string in production
# 3. Set MOMO_SANDBOX=false for real payment processing
# 4. See SETUP_GUIDE.md for detailed configuration instructions
